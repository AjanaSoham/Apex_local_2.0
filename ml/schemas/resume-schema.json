{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeParseResponse",
  "type": "object",
  "required": ["status", "language", "resume", "warnings", "parserVersion"],
  "properties": {
    "status": {"enum": ["COMPLETED", "PARTIAL", "FAILED"]},
    "language": {"const": "en"},
    "resume": {"type": "object", "required": ["skills"], "properties": {"skills": {"type": "array", "items": {"type": "object", "required": ["name", "normalizedName", "confidence"]}}}},
    "warnings": {"type": "array", "items": {"type": "string"}}, "parserVersion": {"type": "string"}
  }
}
